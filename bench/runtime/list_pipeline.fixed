// List pipeline: build 0..10000, map twice, sum; 200 times.
// Size: list of 10,000, 200 times
// Measures closure calls per element and intermediate lists (fold specialisation, reuse).
use std.io.Console

fn upto(n: u64) -> List of u64 =
    List.unfold(0, (i) ->
        if i >= n:
            List.Nil
        else:
            List.Cons(i, i + 1)
    )

fn pipeline(n: u64) -> u64 =
    upto(n).map((x) -> x * 3).map((x) -> x + 1).fold(0, (acc, x) -> acc + x)

fn main() -> () with Console =
    Console.printLine(upto(200).fold(0, (acc, _) -> acc + pipeline(10000)).show())

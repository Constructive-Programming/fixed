// Binary trees: unfold a complete tree of depth 20, fold it to its node count.
// Size: complete tree of depth 20 (2,097,151 nodes)
// Measures allocation and freeing of many small nodes (regions, packed layout and
// tree-fold parallelism later).
use std.io.Console

data Tree:
    Leaf
    Node(left: Tree, right: Tree)

fn make(depth: u64) -> Tree =
    Tree.unfold(depth, (d) ->
        if d == 0:
            Tree.Leaf
        else:
            Tree.Node(d - 1, d - 1)
    )

fn count(t: Tree) -> u64 =
    t.fold(() -> 1, (l, r) -> l + r + 1)

fn main() -> () with Console =
    Console.printLine(count(make(20)).show())

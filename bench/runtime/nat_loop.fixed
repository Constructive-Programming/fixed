// Counted loop: a Nat of depth 10000 unfolded and folded, 200 times.
// Size: Nat of depth 10,000, 200 times
// Measures what guaranteed fold fusion (Rule 7.4.b.1) removes.
use std.io.Console

fn upto(n: u64) -> List of u64 =
    List.unfold(0, (i) ->
        if i >= n:
            List.Nil
        else:
            List.Cons(i, i + 1)
    )

fn steps(n: u64) -> u64 =
    Nat.unfold(n, (k) ->
        if k == 0:
            Nat.Zero
        else:
            Nat.Succ(k - 1)
    ).fold(() -> 0, (acc) -> acc + 1)

fn main() -> () with Console =
    Console.printLine(upto(200).fold(0, (acc, _) -> acc + steps(10000)).show())

// Abort-heavy loop: fold a list of 10000 with a check that aborts near the end, caught
// Size: list of 10,000, abort at element 9,991, 200 times
// by a handler; 200 times. Measures the checked-abort cost (later: evidence passing).
use std.io.Console

fn upto(n: u64) -> List of u64 =
    List.unfold(0, (i) ->
        if i >= n:
            List.Nil
        else:
            List.Cons(i, i + 1)
    )

fn check(n: u64) -> u64 with Fail of String =
    if n > 9990:
        Fail.fail("too big")
    else:
        n

fn total(xs: List of u64) -> u64 with Fail of String =
    xs.fold(0, (acc, x) -> acc + check(x))

fn attempt() -> u64 =
    handle total(upto(10000)):
        Fail.fail(_) => 1
        return(v) => v

fn main() -> () with Console =
    Console.printLine(upto(200).fold(0, (acc, _) -> acc + attempt()).show())

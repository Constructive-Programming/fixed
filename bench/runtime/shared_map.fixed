// Real sharing at the reuse site: `base` stays alive while it is mapped 200 times,
// so every rc == 1 test fails and map allocates a fresh list.
// Size: list of 10,000 mapped 200 times while shared
use std.io.Console

fn upto(n: u64) -> List of u64 =
    List.unfold(0, (i) ->
        if i >= n:
            List.Nil
        else:
            List.Cons(i, i + 1)
    )

fn bump_sum(xs: List of u64) -> u64 = xs.map((x) -> x + 1).fold(0, (a, x) -> a + x)

fn main() -> () with Console =
    let base = upto(10000)
    let t = upto(200).fold(0, (acc, _) -> acc + bump_sum(base))
    Console.printLine((t + base.fold(0, (a, x) -> a + x)).show())

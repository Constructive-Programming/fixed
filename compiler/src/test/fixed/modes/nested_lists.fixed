// Generated members (foldLeft, length, map, unfold) over a list whose element is a list.
use std.io.Console

fn lens(xss: List of A) -> u64 = xss.fold(0, (n, x) -> n + 1)

fn total(xss: List of List of u64) -> u64 = xss.fold(0, (n, xs) -> n + xs.fold(0, (m, x) -> m + x))

fn len2(xss: List of List of u64) -> u64 = xss.length()

fn inner(xss: List of List of u64) -> List of u64 = xss.map((xs) -> xs.fold(0, (m, x) -> m + x))

fn nested(n: u64) -> List of List of u64 =
    List.unfold(0, (i) -> if i >= n: List.Nil else: List.Cons([i, i], i + 1))

fn good(xs: List of String) -> u64 = lens([xs, xs])

fn main() -> () with Console =
    let a = [1, 2]
    Console.print_line(lens([a, a, a]).show())
    Console.print_line(total([a, [3]]).show())
    Console.print_line(len2([a, a]).show())
    Console.print_line(inner([a, [5, 6]]).fold("", (s, x) -> s.concat(x.show())))
    Console.print_line(total(nested(4)).show())
    Console.print_line(good(["a".concat("b"), "c"]).show())

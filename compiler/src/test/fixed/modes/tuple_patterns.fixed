// Tuple patterns in `match`: of binders, nested, and on a parameter written `Tuple of (A, B)`. Each
// `match` but the first ends in an arm that prints something else, taken only if the tuple pattern
// fails to match.
use std.io.Console

fn sum(p: (u64, u64)) -> u64 = match p:
    (a, b) => a + b

fn swap(p: ((u64, bool), u64)) -> String = match p:
    ((a, f), z) => f.show().concat(" ").concat(z.show()).concat(" ").concat(a.show())
    _ => "fell through"

fn named(p: Tuple of (u64, String)) -> String = match p:
    (a, s) => s.concat(a.show())
    _ => "fell through"

fn main() -> () with Console =
    Console.printLine(sum((3, 4)).show())
    Console.printLine(swap(((1, true), 2)))
    Console.printLine(named(Tuple.Tuple(5, "n")))

// Derived unfold and map, and the generated length, of a list of 2,000,000 elements, generic and at
// known arguments: one native frame per element would overflow an 8 MiB stack. Unfold and map run
// as loops (Generated.loopStep); so do those of N, whose last cell has a field and whose nullary
// variant is not the first, and of L, with two recursive variants. `length` runs as `lengthLoop`; on
// a list still used after it, clang does not turn the old recursion into a loop. The derived fold
// of N and L (`nsum`, `lsum`) runs as foldDown and foldUp.
use std.io.Console

data N of A:
    End(a: A)
    None
    More(a: A, r: N of A)

N satisfies Functor

data L of A:
    Nil
    One(a: A, r: L of A)
    Two(a: A, b: A, r: L of A)

L satisfies Functor

fn nsum(n: N of u64) -> u64 = n.fold((a) -> a * 1000, () -> 0, (a, r) -> a + r * 10)

fn lsum(l: L of u64) -> u64 = l.fold(() -> 0, (a, r) -> a + r * 10, (a, b, r) -> a * 3 + b + r * 10)

fn upto(n: u64) -> List of u64 = List.unfold(0, (i) -> if i >= n: List.Nil else: List.Cons(i, i + 1))

fn gmap(xs: List of A, f: A -> B) -> List of B = xs.map(f)

fn size(xs: is Sequencing of A) -> u64 = xs.length()

fn gupto(x: A, n: u64) -> List of A = List.unfold(n, (i) -> if i == 0: List.Nil else: List.Cons(x, i - 1))

fn main() -> () with Console =
    let xs = upto(2000000)
    Console.printLine(xs.length().show())
    Console.printLine(size(xs).show())
    Console.printLine(xs.map((x) -> x * 2).fold(0, (a, x) -> a + x).show())
    Console.printLine(gmap(xs, (x) -> x % 3).fold(0, (a, x) -> a + x).show())
    Console.printLine(xs.fold(0, (a, x) -> a + x).show())
    Console.printLine(gupto("ab", 2000000).fold(0, (a, s) -> a + 1).show())
    let n = N.unfold(3, (i) -> if i == 0: N.End(7) else: N.More(i, i - 1))
    Console.printLine(nsum(n).show())
    Console.printLine(nsum(n.map((x) -> x + 1)).show())
    let l = L.unfold(4, (i) -> if i == 0: L.Nil else: if i % 2 == 0: L.Two(i, 1, i - 1) else: L.One(i, i - 1))
    Console.printLine(lsum(l).show())
    Console.printLine(lsum(l.map((x) -> x * 2)).show())

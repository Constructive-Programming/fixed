// Clone on request (spec/stdlib.md §4.11): the derived clone copies each cell and clones each field,
// through a program's own satisfies body where a field's type has one; scalars and String are
// themselves; at a type parameter through its table, built at run time for `Box of T` in `wrapDup`.
// The original stays usable after the clone.
use std.io.Console

data Box of A:
    Box(v: A)

Box satisfies Clone

data Tree of A:
    Leaf
    Node(left: Tree of A, value: A, right: Tree of A)

Tree satisfies Clone

data Own:
    Own(n: u64)

Own satisfies Clone:
    fn clone = Own.Own(self.n + 1)

data Wrap:
    Wrap(o: Own, s: String)

Wrap satisfies Clone

fn dup(x: T is Clone + Show) -> String = x.clone().show()

fn boxed(b: Box of T is Clone + Show) -> String = b.clone().show()

fn wrapDup(x: T is Clone + Show) -> String = dup(Box.Box(x))

fn main() -> () with Console =
    let t = Tree.Node(Tree.Leaf, Box.Box(2.5), Tree.Node(Tree.Leaf, Box.Box(1.0), Tree.Leaf))
    let c = t.clone()
    Console.printLine(c.show().concat(" ").concat(t.show()))
    Console.printLine(dup(3).concat(" ").concat(dup("s")).concat(" ").concat(dup(Box.Box(7))).concat(" ").concat(dup([1, 2])))
    Console.printLine(boxed(Box.Box("x")).concat(" ").concat(Wrap.Wrap(Own.Own(1), "w").clone().show()))
    Console.printLine((5).clone().show().concat(" ").concat("s".clone()).concat(" ").concat([1, 2].clone().show()))
    Console.printLine(wrapDup(3).concat(" ").concat(wrapDup([1, 2])))

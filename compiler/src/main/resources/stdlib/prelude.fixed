// The standard prelude, in scope in every compilation unit (spec/stdlib.md):
// declarations, and bodies for the members the compiler does not generate.
// `String` itself is built into the Namer: it has no variants to declare.

data List of A:
    Cons(head: A, tail: List of A)
    Nil

data Json:
    Null
    Bool(value: bool)
    Number(value: f64)
    String(value: String)
    // The derived `Json satisfies Show` and `Eq` call `show` and `eq` on these fields (stdlib.md 3.2).
    Array(elements: is Sequencing of Json + Show + Eq)
    Object(fields: is Map of (String, Json) + Show + Eq)

data Tuple of (A, B):
    Tuple(first: A, second: B)

data Maybe of A:
    Just(value: A)
    Nothing

data Nat:
    Zero
    Succ(pred: Nat)

data Order:
    Less
    Equal
    Greater

cap Functor:
    fn map(f: Part -> B) -> Self of B

cap Folding:
    fn fold(init: R, f: (R, Part) -> R) -> R
    fn foldRight(init: R, f: (Part, R) -> R) -> R
    fn find(pred: Part -> bool) -> is Optional of Part

cap Sequencing:
    fn length -> u64
    fn head -> is Optional of Part
    fn tail -> Self
    Self.fn cons(h: Part, t: is Sequencing of Part) -> Self
    Self.fn empty -> Self

cap Filtering:
    fn filter(pred: Part -> bool) -> Self

cap Empty:
    Self.fn empty -> Self

cap Sized of (Part, Size is Numeric):
    fn size -> Size

cap Map of (K, V):
    fn get(key: K) -> is Optional of V

cap Optional extends Functor + Folding:
    Self.fn some(value: Part) -> Self
    Self.fn none -> Self
    fn fold(onSome: Part -> R, onNone: () -> R) -> R

cap Result of (E, A):
    Self.fn ok(value: A) -> Self
    Self.fn err(error: E) -> Self
    fn fold(onOk: A -> R, onErr: E -> R) -> R

cap Pair of (A, B):
    Self.fn pair(a: A, b: B) -> Self
    fn first -> A
    fn second -> B

cap Ordering:
    Self.fn lt -> Self
    Self.fn eq -> Self
    Self.fn gt -> Self
    fn fold(onLt: () -> R, onEq: () -> R, onGt: () -> R) -> R

cap Boolean:
    Self.fn yes -> Self
    Self.fn no -> Self
    fn fold(onYes: () -> R, onNo: () -> R) -> R

cap Eq:
    fn eq(other: Self) -> bool

cap Ord extends Eq:
    fn compare(other: Self) -> is Ordering

cap Numeric extends Eq + Ord:
    Self.fn fromI64(n: i64) -> Self
    fn add(other: Self) -> Self
    fn sub(other: Self) -> Self
    fn mul(other: Self) -> Self
    fn div(other: Self) -> Self
    fn rem(other: Self) -> Self
    fn negate -> Self

cap Show:
    fn show -> String

cap Clone:
    fn clone -> Self

cap Concat:
    fn concat(other: Self) -> Self

// String helpers the examples use; Phase 5 decides where they live. They have bodies, so the
// backend slice can compile them (docs/plans/phase-4.0-backend-slice.md §4.4).
fn repeatStr(s: String, times: u64) -> String =
    Nat.unfold(times, (k: u64) ->
        if k == 0:
            Nat.Zero
        else:
            Nat.Succ(k - 1)
    ).fold(() -> "", (acc) -> acc.concat(s))

fn join(parts: is Folding of String, separator: String) -> String =
    parts.fold(("", true), (acc, part) ->
        let (out, first) = acc
        if first:
            (part, false)
        else:
            (out.concat(separator).concat(part), false)
    ).first

effect Fail of E:
    fn fail(error: E) -> !

// Rule 7.4.h: a function whose row has `Diverge` may recurse without restriction (it may not
// return). It has no operations, and no handler removes it.
effect Diverge

String satisfies Show
String satisfies Concat
String satisfies Eq
String satisfies Ord
List satisfies Sequencing:
    Cons as cons
    Nil as empty
    fn length = self.fold(0, (n, x) -> n + 1)
    fn head = match self:
        List.Cons(h, _) => Optional.some(h)
        List.Nil => Optional.none
    fn tail = match self:
        List.Cons(_, t) => t
        List.Nil => List.Nil
List satisfies Folding:
    fn fold(init: R, f: (R, Part) -> R) = self.fold((h, rest: R -> R) -> (acc) -> rest(f(acc, h)), () -> (acc) -> acc)(init)
    fn foldRight(init: R, f: (Part, R) -> R) = self.fold((h, acc) -> f(h, acc), () -> init)
    fn find(pred: Part -> bool) = self.fold((x, found) -> if pred(x): Optional.some(x) else: found, () -> Optional.none)
List satisfies Functor
List satisfies Filtering:
    fn filter(pred: Part -> bool) = self.fold((x, kept) -> if pred(x): List.Cons(x, kept) else: kept, () -> List.Nil)
Maybe satisfies Optional:
    Just as some
    Nothing as none
Maybe satisfies Folding:
    fn fold(init: R, f: (R, Part) -> R) = match self:
        Maybe.Just(v) => f(init, v)
        Maybe.Nothing => init
    fn foldRight(init: R, f: (Part, R) -> R) = match self:
        Maybe.Just(v) => f(v, init)
        Maybe.Nothing => init
    fn find(pred: Part -> bool) = match self:
        Maybe.Just(v) => if pred(v): self else: Maybe.Nothing
        Maybe.Nothing => self
Json satisfies Show
Json satisfies Eq
String satisfies Clone
List satisfies Clone
Maybe satisfies Clone
Nat satisfies Clone
Tuple satisfies Clone
Order satisfies Clone
Order satisfies Ordering:
    Less as lt
    Equal as eq
    Greater as gt
Tuple satisfies Pair:
    Tuple as pair
bool satisfies Boolean:
    Self as yes
    Self as no
bool satisfies Show
bool satisfies Eq
char satisfies Show
char satisfies Eq
char satisfies Ord
i8 satisfies Show
i16 satisfies Show
i32 satisfies Show
i64 satisfies Show
u8 satisfies Show
u16 satisfies Show
u32 satisfies Show
u64 satisfies Show
f32 satisfies Show
f64 satisfies Show

// 09_interpreter.fixed
// A mini expression language interpreter.
//
// Demonstrates:
//   - fold-based evaluation on a capability (Expr) — no pattern matching on caps
//   - `satisfies` mapping concrete AST nodes to abstract Expr constructors
//   - Mutual recursion (Expr references itself)
//   - Effects for runtime errors (EvalError)
//   - Combining fold with effects
//   - fold-based pretty printing
//   - match only on data types (List), fold for capabilities (Expr, Optional)
//   - A non-trivial program showing Fixed's expressiveness

use std.io.Console

// --- The expression AST (capability declares requirements) ---

cap Expr:
    Self.fn lit(value: f64) -> Self
    Self.fn var(name: String) -> Self
    Self.fn add(left: Self, right: Self) -> Self
    Self.fn mul(left: Self, right: Self) -> Self
    Self.fn neg(inner: Self) -> Self
    Self.fn letIn(name: String, value: Self, body: Self) -> Self
    Self.fn ifThen(cond: Self, thenBranch: Self, elseBranch: Self) -> Self
    Self.fn call(funcName: String, args: List of Self) -> Self
    fn fold<R>(
        onLit: f64 -> R,
        onVar: String -> R,
        onAdd: (R, R) -> R,
        onMul: (R, R) -> R,
        onNeg: R -> R,
        onLet: (String, R, R) -> R,
        onIf: (R, R, R) -> R,
        onCall: (String, List of R) -> R,
    ) -> R

// --- Concrete AST data type satisfies Expr ---

data AstNode:
    Literal(value: f64)
    Variable(name: String)
    Sum(left: AstNode, right: AstNode)
    Product(left: AstNode, right: AstNode)
    Negate(inner: AstNode)
    LetBinding(name: String, value: AstNode, body: AstNode)
    Conditional(cond: AstNode, thenBranch: AstNode, elseBranch: AstNode)
    FnCall(funcName: String, args: List of AstNode)

AstNode satisfies Expr:
    Literal as lit
    Variable as var
    Sum as add
    Product as mul
    Negate as neg
    LetBinding as letIn
    Conditional as ifThen
    FnCall as call

// --- The environment (variable bindings) ---

cap Env:
    Self.fn empty -> Self
    fn bind(name: String, value: f64) -> Self
    fn lookup(name: String) -> is Optional of f64

// --- Concrete environment ---

data VarMap(bindings: List of (is Pair of (String, f64)) = List.Nil)

VarMap satisfies Env:
    VarMap as empty
    fn bind(name: String, value: f64) = VarMap.VarMap(List.Cons(Pair.pair(name, value), self.bindings))
    fn lookup(name: String) = self.bindings.foldRight(Optional.none, (entry, found) ->
        if entry.first == name: Optional.some(entry.second) else: found
    )

// --- Built-in function registry ---

cap Builtins:
    fn evalBuiltin(
        name: String,
        args: List of f64,
    ) -> is Optional of f64

fn defaultBuiltins() -> is Builtins =
    // The compiler generates a concrete implementation.
    // In practice this would use a Map internally.
    fn evalBuiltin(name: String, args: List of f64) -> is Optional of f64 =
        if name == "sqrt":
            match args:
                List.Cons(x, List.Nil) => Optional.some(builtin.sqrt(x))
                _ => Optional.none
        else if name == "abs":
            match args:
                List.Cons(x, List.Nil) =>
                    Optional.some(if x < 0.0: -x else: x)
                _ => Optional.none
        else if name == "max":
            match args:
                List.Cons(a, List.Cons(b, List.Nil)) =>
                    Optional.some(if a > b: a else: b)
                _ => Optional.none
        else:
            Optional.none

// --- The evaluator ---

effect EvalError:
    fn evalError(message: String) -> !

// Expr is a capability — we cannot pattern match on it.
// Instead, fold with R = (is Env -> f64 with EvalError).
// Each callback returns a *deferred* computation from env to value,
// allowing lazy evaluation (e.g., ifThen doesn't evaluate both branches).
fn eval(expr: is Expr, env: is Env) -> f64 with EvalError =
    expr.fold(
        (v) -> (env) -> v,
        (name) -> (env) -> env.lookup(name).fold(
            (v) -> v,
            () -> EvalError.evalError("undefined variable: ".concat(name)),
        ),
        (leftFn, rightFn) -> (env) -> leftFn(env) + rightFn(env),
        (leftFn, rightFn) -> (env) -> leftFn(env) * rightFn(env),
        (innerFn) -> (env) -> -innerFn(env),
        (name, valFn, bodyFn) -> (env) ->
            let v = valFn(env)
            bodyFn(env.bind(name, v)),
        (condFn, thenFn, elseFn) -> (env) ->
            if condFn(env) != 0.0: thenFn(env) else: elseFn(env),
        (funcName, argFns) -> (env) ->
            let args = map(argFns, (f) -> f(env))
            defaultBuiltins().evalBuiltin(funcName, args).fold(
                (result) -> result,
                () -> EvalError.evalError("unknown function: ".concat(funcName)),
            ),
    )(env)

// --- Pretty printer (using fold — no pattern matching!) ---

fn pretty(expr: is Expr) -> String =
    expr.fold(
        (v) -> v.show(),
        (name) -> name,
        (l, r) -> "(".concat(l).concat(" + ").concat(r).concat(")"),
        (l, r) -> "(".concat(l).concat(" * ").concat(r).concat(")"),
        (inner) -> "(-".concat(inner).concat(")"),
        (name, val, body) ->
            "let ".concat(name).concat(" = ").concat(val)
                  .concat(" in ").concat(body),
        (c, t, e) ->
            "if ".concat(c).concat(" then ").concat(t)
                 .concat(" else ").concat(e),
        (name, args) ->
            name.concat("(").concat(join(args, ", ")).concat(")"),
    )

fn main() -> () with Console =
    // Build: let x = 3.0 in let y = 4.0 in sqrt(x*x + y*y)
    let expr = Expr.letIn("x", Expr.lit(3.0),
        Expr.letIn("y", Expr.lit(4.0),
            Expr.call("sqrt", [
                Expr.add(
                    Expr.mul(Expr.var("x"), Expr.var("x")),
                    Expr.mul(Expr.var("y"), Expr.var("y")),
                )
            ])
        )
    )

    Console.printLine("Expression: ".concat(pretty(expr)))

    let env = Env.empty
    handle (do:
        let result = eval(expr, env)
        Console.printLine("Result: ".concat(result.show()))
    ):
        EvalError.evalError(msg) =>
            Console.printLine("Eval error: ".concat(msg))

    // Build: if (x - 5) then x * 2 else 0
    let expr2 = Expr.ifThen(
        Expr.add(Expr.var("x"), Expr.neg(Expr.lit(5.0))),
        Expr.mul(Expr.var("x"), Expr.lit(2.0)),
        Expr.lit(0.0),
    )

    Console.printLine("Expression: ".concat(pretty(expr2)))

    let env2 = Env.empty.bind("x", 10.0)
    handle (do:
        let result = eval(expr2, env2)
        Console.printLine("Result: ".concat(result.show()))
    ):
        EvalError.evalError(msg) =>
            Console.printLine("Eval error: ".concat(msg))

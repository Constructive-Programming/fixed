// 08_effects_handlers.fixed
// Effect handling: I/O, logging, concurrency — all as algebraic effects.
//
// Demonstrates:
//   - Multiple effect capabilities (Fail, Log, Channel, Async)
//   - Effect rows with `+` composition
//   - Nested handlers — each `handle` removes one effect from the row
//   - Handler-based scheduling (the runtime is a handler, not magic)
//   - Concurrency modeled as algebraic effects (not built-in primitives)
//   - Effect polymorphism in higher-order functions
//   - `satisfies` mapping concrete data to caps (Message, TaskQueue)
//   - Shows how Fixed's effect system subsumes async/await
//   - match for data types (List), fold for capabilities (Optional)

use std.io.{Console, FileSystem}

// =========================================================================
// Part 1: I/O effects — config file reading with error handling
// =========================================================================

// Fail is defined in 03_option_result.fixed; redefined here for
// self-containment. In a real program: `use std.fail.Fail`
effect Fail of E:
    fn fail(error: E) -> !

effect Log:
    fn log(level: String, message: String) -> ()

// --- A config file reader ---

data Config(host: String, port: u16, debug: bool)

fn readConfig(path: String) -> Config
    with FileSystem + Fail of String =
    let contents = FileSystem.readFile(path).fold(
        (v) -> v,
        (e) -> Fail.fail(e),
    )
    parseConfig(contents)

fn parseConfig(text: String) -> Config
    with Fail of String =
    let lines = splitLines(text)
    let host = findValue(lines, "host").fold(
        (v) -> v,
        () -> Fail.fail("missing config key: host"),
    )
    let portStr = findValue(lines, "port").fold(
        (v) -> v,
        () -> Fail.fail("missing config key: port"),
    )
    let port = parseU16(portStr).fold(
        (v) -> v,
        (e) -> Fail.fail(e),
    )
    let debug = findValue(lines, "debug")
        |> mapOptional((v) -> v == "true")
        |> unwrapOr(false)
    Config(host, port, debug)

// Pure helper — no effects needed, no `with` clause
fn findValue(
    lines: List of String,
    key: String,
) -> is Optional of String =
    find(lines, (line) -> startsWith(line, key))
        |> mapOptional((line) -> afterChar(line, '='))
        |> mapOptional((value) -> trim(value))

fn runServer(config: Config) -> () with Console + Log =
    Log.log("info", "Starting server...")
    Console.printLine(
        "Server running on "
            .concat(config.host)
            .concat(":")
            .concat(config.port.show())
    )

    if config.debug:
        Log.log("debug", "Debug mode enabled")
        Console.printLine("[DEBUG] Verbose output on")
    else:
        ()

// =========================================================================
// Part 2: Concurrency as algebraic effects
// =========================================================================

// A typed channel for sending/receiving messages
effect Channel of A:
    fn send(value: A) -> ()
    fn receive -> A

// Spawning concurrent tasks
effect Async:
    fn spawn(task: () -> () with Async + E) -> () with E
    fn yieldNow -> ()

// --- A chat message ---

cap Message:
    Self.fn new(sender: String, body: String) -> Self
    fn sender -> String
    fn body -> String

data ChatMessage(sender: String, body: String)

ChatMessage satisfies Message:
    ChatMessage as new

// --- Chat room logic ---
//
// Functions in Fixed are total — chatLoop and listenLoop cannot
// self-recurse on an unbounded effect-driven loop. We bound each by a
// `maxMessages` parameter and fold a Nat of that depth, propagating an
// "already terminated" flag when "quit" arrives so further iterations
// no-op. (A future codata story — see implementation-plan.md OQ12 — would
// admit truly unbounded conversational loops without an iteration cap.)

fn participant(name: String, maxMessages: u64) -> ()
    with Console + Channel of (is Message) + Async =
    Console.printLine(name.concat(" joined the chat"))

    Nat.unfold(maxMessages, (k) ->
        if k == 0: Nat.Zero
        else: Nat.Succ(k - 1)
    ).fold(
        () -> false,                                  // not yet quit
        (terminated) ->
            if terminated:
                true
            else:
                Console.printLine(name.concat("> "))
                let input = Console.readLine()
                if input == "quit":
                    Console.printLine(name.concat(" left the chat"))
                    true
                else:
                    Channel.send(Message.new(name, input))
                    Async.yieldNow
                    false
    )
    ()

fn listener(maxMessages: u64) -> ()
    with Console + Channel of (is Message) + Async =
    Nat.unfold(maxMessages, (k) ->
        if k == 0: Nat.Zero
        else: Nat.Succ(k - 1)
    ).fold(
        () -> (),
        (_) ->
            let msg = Channel.receive
            Console.printLine(
                "[".concat(msg.sender).concat("]: ").concat(msg.body)
            )
            Async.yieldNow
            ()
    )

// =========================================================================
// Part 3: Handler composition — schedulers and channels
// =========================================================================

cap TaskQueue:
    Self.fn empty -> Self
    fn push(task: () -> () with Async) -> Self
    fn pop -> is Optional of (is Pair of (() -> () with Async, Self))
    fn isEmpty -> bool

data SimpleQueue(tasks: List of (() -> () with Async) = List.Nil)

SimpleQueue satisfies TaskQueue:
    SimpleQueue as empty
    fn push(task: () -> () with Async) =
        SimpleQueue.SimpleQueue(self.tasks.foldRight(List.Cons(task, List.Nil), (t, rest) -> List.Cons(t, rest)))
    fn pop = match self.tasks:
        List.Cons(task, rest) => Optional.some(Pair.pair(task, SimpleQueue.SimpleQueue(rest)))
        List.Nil => Optional.none
    fn isEmpty = match self.tasks:
        List.Cons(_, _) => false
        List.Nil => true

// runScheduler: total schedulers also need an iteration bound (maxSteps).
// Each fold step pops one task from the queue, runs one effect, and updates
// the queue. After maxSteps or when the queue empties, the scheduler stops.
fn runScheduler(task: () -> () with Async + E, maxSteps: u64) -> () with E =
    let initialQueue = TaskQueue.empty.push(() ->
        handle task():
            Async.spawn(t) => resume(())
            Async.yieldNow() => resume(())
    )

    Nat.unfold(maxSteps, (k) ->
        if k == 0: Nat.Zero
        else: Nat.Succ(k - 1)
    ).fold(
        () -> initialQueue,
        (queue) ->
            queue.pop.fold(
                (pair) ->
                    let nextTask = pair.first
                    let remaining = pair.second
                    handle nextTask():
                        Async.spawn(newTask) =>
                            let q = remaining.push(newTask)
                            resume(())
                            q
                        Async.yieldNow() =>
                            let q = remaining.push(() -> resume(()))
                            q,
                () -> queue,    // empty queue: idempotent
            )
    )
    ()

// runWithChannel: same shape — bound the dispatcher with maxSteps.
// State is (buffer, current task). Each step intercepts one Channel op.
fn runWithChannel(task: () -> () with Channel of A + E, maxSteps: u64) -> () with E =
    Nat.unfold(maxSteps, (k) ->
        if k == 0: Nat.Zero
        else: Nat.Succ(k - 1)
    ).fold(
        () -> (List.Nil, task),                       // (buffer, current)
        (acc) ->
            let (buffer, t) = acc
            handle t():
                Channel.send(value) =>
                    (List.Cons(value, buffer), () -> resume(()))
                Channel.receive() =>
                    match buffer:
                        List.Cons(head, tail) =>
                            (tail, () -> resume(head))
                        List.Nil =>
                            (buffer, t)               // no-op
    )
    ()

// =========================================================================
// Part 4: Nested handlers — putting it all together
// =========================================================================

fn main() -> () with FileSystem =
    // Example 1: I/O effects with nested handlers
    // Each `handle` removes one effect from the row.
    handle (do:
        handle (do:
            handle (do:
                let config = readConfig("server.conf")
                runServer(config)
            ):
                Fail.fail(e) =>
                    builtin.stderrWrite("Fatal: ".concat(e))
                    builtin.exit(1)
        ):
            Log.log(level, msg) =>
                builtin.stderrWrite("[".concat(level).concat("] ").concat(msg).concat("\n"))
                resume(())
    ):
        Console.printLine(msg) =>
            builtin.stdoutWrite(msg.concat("\n"))
            resume(())
        Console.readLine() =>
            resume(builtin.stdinReadLine())

    // Example 2: Concurrency effects with nested handlers
    //
    // All four "loops" (participant, listener, runScheduler, runWithChannel)
    // are bounded by max-iteration parameters per the totality discussion at
    // the participant/listener definitions. The numbers below are
    // demonstration-scale; a real program with a codata-based loop story
    // (deferred per implementation-plan.md OQ12) would not need them.
    handle (do:
        runScheduler(() ->
            runWithChannel(() ->
                Async.spawn(() -> participant("Alice", 32))
                Async.spawn(() -> participant("Bob", 32))
                Async.spawn(() -> listener(64))
            , 256),     // runWithChannel maxSteps
            256)        // runScheduler maxSteps
    ):
        Console.printLine(msg) =>
            builtin.stdoutWrite(msg.concat("\n"))
            resume(())
        Console.readLine() =>
            resume(builtin.stdinReadLine())

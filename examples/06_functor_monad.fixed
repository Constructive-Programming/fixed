// 06_functor_monad.fixed
// Higher-kinded types: Functor, Monad, do-notation, generic programming.
//
// Demonstrates:
//   - HKT syntax: `Self of B` for type-constructor returns
//   - Functor/Monad capability hierarchy using `extends`
//   - `satisfies` connecting MyMaybe data type to Optional cap
//   - `do` notation as sugar for flatMap chains
//   - Generic functions that work over any Monad
//   - Auto-derived fold and map; flatMap and pure written in the satisfaction
//   - match for data types (List), fold for capabilities (Optional)

use std.io.Console

// --- The capability hierarchy ---

// Functor comes from the prelude (a structure-preserving transformation):
// `fn map(f: Part -> B) -> Self of B`, where `Part` is the current element
// type and `Self of B` the container at the new one. The compiler derives
// `map` for the prelude's Functor only, not for a program's own `cap Functor`.

// Monad: sequencing computations that produce wrapped values.
// `pure` wraps a value; `flatMap` chains computations.
cap Monad extends Functor:
    Self.fn pure(value: Part) -> Self
    fn flatMap(f: Part -> Self of B) -> Self of B

// --- Optional is a Monad ---
//
// Optional declares some/none/fold as constructor requirements.
// The compiler auto-derives Functor (map) from the structure; Monad's
// pure and flatMap are written in the satisfaction below.

cap Optional extends Monad:
    Self.fn some(value: Part) -> Self
    Self.fn none -> Self
    fn fold(onSome: Part -> R, onNone: () -> R) -> R

// A concrete data type satisfies Optional (and thus Monad + Functor):
data MyMaybe of A:
    Just(value: A)
    Nothing

MyMaybe satisfies Optional:
    Just as some
    Nothing as none
    Self.fn pure(value: Part) -> Self = MyMaybe.Just(value)
    fn flatMap(f: Part -> Self of B) = match self:
        MyMaybe.Just(a) => f(a)
        MyMaybe.Nothing => MyMaybe.Nothing
// fold and map are auto-derived from MyMaybe's structure

// --- Generic monadic functions ---

// `M is Monad` — M is a type constructor satisfying Monad.
// `M of ()` applies M to the unit type.
fn when(condition: bool, action: M is Monad of ()) -> M of () =
    if condition:
        action
    else:
        M.pure(())

// Functions in Fixed are total — `sequence` and `foldM` cannot self-recurse.
// Both are catamorphisms over the input List, so we use List's auto-derived
// `fold` (catamorphism style: one callback per variant, with recursive
// positions already folded to the result type R).

fn sequence(list: List of (M is Monad of A)) -> M of (List of A) =
    list.fold(
        // Cons(head, tail): `tail` has already been folded to `M of (List of A)`.
        (head, tailM) ->
            do:
                a <- head
                rest <- tailM
                M.pure(List.Cons(a, rest)),
        // Nil:
        () -> M.pure(List.Nil),
    )

fn mapM(list: List of A, f: A -> M of B) -> (M is Monad) of (List of B) =
    sequence(list.map(f))

fn foldM(
    list: List of A,
    init: B,
    f: (B, A) -> M of B,
) -> (M is Monad) of B =
    // The natural shape is *right-folded* monadic build-up — but we want a
    // left-fold-style traversal (apply `f` to elements in order). Express it
    // as a continuation-passing fold: each Cons callback returns a function
    // `B -> M of B` that, given the accumulator-so-far, runs `f` then chains
    // into the tail's continuation.
    let kont = list.fold(
        (head, tailKont: B -> M of B) ->
            (acc: B) ->
                do:
                    next <- f(acc, head)
                    tailKont(next),
        () -> (acc: B) -> M.pure(acc),
    )
    kont(init)

// --- do notation example ---

fn safeDivide(a: f64, b: f64) -> is Optional of f64 =
    if b == 0.0:
        Optional.none
    else:
        Optional.some(a / b)

fn compute() -> is Optional of f64 =
    // `do` desugars to flatMap chains:
    //   safeDivide(100.0, 3.0).flatMap((x) ->
    //     safeDivide(x, 2.0).flatMap((y) ->
    //       safeDivide(y, 7.0).flatMap((z) ->
    //         Optional.pure(z))))
    do:
        x <- safeDivide(100.0, 3.0)
        y <- safeDivide(x, 2.0)
        z <- safeDivide(y, 7.0)
        Optional.pure(x + y + z)

// --- Functor laws (expressed as properties) ---

// fmap id == id
// fmap (f . g) == fmap f . fmap g

fn main() -> () with Console =
    compute().fold(
        (result) -> Console.printLine("Result: ".concat(result.show())),
        () -> Console.printLine("Division by zero encountered"),
    )

    // sequence example: all-or-nothing
    let opts = [Optional.some(1), Optional.some(2), Optional.some(3)]
    sequence(opts).fold(
        (list) -> Console.printLine("All present: ".concat(list.show())),
        () -> Console.printLine("At least one was none"),
    )
